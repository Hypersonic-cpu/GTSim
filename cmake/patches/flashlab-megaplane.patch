+std::optional<HbfDevice::RawPage> HbfDevice::raw_page(std::uint64_t ppn,double at) const {
+    const auto found = cache_.find(raw_bank(ppn));
+    if (found == cache_.end()) return std::nullopt;
+    const auto key = raw_key(ppn);
+    const auto state = project_cache(found->second,at);
+    const auto page = std::find(state.begin(),state.end(),key);
+    if (page != state.end()) {
+        const auto i = page-state.begin();
+        return RawPage{state.ready_ns[i],state.generation[i]};
+    }
+    for (const auto& event : found->second.events)
+        if (event.at_ns > at && event.event.action > 0 && event.event.page == key)
+            return RawPage{event.event.ready_ns,event.event.generation};
+    return std::nullopt;
+}
+bool HbfDevice::raw_reserve(std::uint64_t ppn,double start,double ready,std::uint64_t& gen) {
+    auto& bank = cache_[raw_bank(ppn)];
+    gen = ++touch_sequence_;
+    const auto key = raw_key(ppn);
+    if (!record_event(bank,TimedEvent{start,gen,CacheEvent{key,1,ready,gen}})) return false;
+    bank.candidates.insert(key);
+    track_cache_events(raw_bank(ppn),bank);
+    return true;
+}
+bool HbfDevice::raw_touch(std::uint64_t ppn,double at,std::uint64_t gen) {
+    auto& bank = cache_.at(raw_bank(ppn));
+    const auto key = raw_key(ppn);
+    if (!record_event(bank,TimedEvent{at,++touch_sequence_,CacheEvent{key,0,at,gen}})) return false;
+    ++bank.future_consumers;
+    track_cache_events(raw_bank(ppn),bank);
+    return true;
+}
+double HbfDevice::raw_retry_after(std::uint64_t ppn,double at) const {
+    const auto found = cache_.find(raw_bank(ppn));
+    return found == cache_.end() || found->second.events.empty() ? at :
+        std::max(at,found->second.events.back().at_ns);
+}
+bool HbfDevice::decoded_valid(std::uint64_t ppn,double at,std::uint64_t gen) const {
+    if (!config_.grouped_geometry) return true;
+    const auto found = cache_.find(raw_bank(ppn));
+    if (found == cache_.end()) return false;
+    const auto state = project_cache(found->second,at);
+    const auto key = raw_key(ppn);
+    const auto page = std::find(state.begin(),state.end(),key);
+    if (page == state.end()) return false;
+    const auto index = page-state.begin();
+    return state.generation[index] == gen && state.ready_ns[index] <= at;
+}
