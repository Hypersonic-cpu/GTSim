flow.kernel @weighted_direct_flow schedule<explicit> target<sm90> {
  static.param %B : index
  static.param %H : index
  static.param %TK : index
  static.param %NUM_SMS : index
  static.param %IDS : index_list
  static.let %ASSIGNMENTS = %B*%TK
  static.let %ORDER = argsort(%IDS)
  static.let %INVERSE = inverse_permutation(%ORDER)
  flow.tensor @ExpertOutput : tensor<ASSIGNMENTSxHxbf16, row_major>
  flow.tensor @Probabilities : tensor<BxTKxbf16, row_major>
  flow.tensor @Output : tensor<BxHxbf16, row_major>
  flow.schedule_config tile(1x4096x1) stages(1) warps(4) consumer_warps(1) producer_warp(0) warpgroup(4) matrix_tile(64x64x16)
  flow.loop @cta %cta = 0 to %B step 1
  flow.loop @wave %wave = 0 to 1 step 1
  flow.executor %producer role<producer> organization<independent>
  flow.executor %matrix role<matrix> organization<cooperative>
  flow.buffer %scratch slots(1) access<read_write> : bytes_per_slot<16384>
  static.if <%k==0> {
    flow.dependency_rule @acc_state from[@zero.complete] at[%wave = %wave] select<all>
  }
  static.if <%k>0> {
    flow.dependency_rule @acc_state from[@add.complete] at[%wave = %wave, %k = %k-1] select<all>
  }
  flow.dependency_rule @last from[@add.complete] at[%wave = %wave, %k = %TK-1] select<all>
  %zero = flow.arithmetic @zero implements<@zero> reads[] : tensor<1xHxfp32> scope<prologue>
  flow.pipeline @loop %k = 0 to %TK step 1 depth(1) generation_counts_per_wave[1] {
    %expert, !expert_ready = flow.load_async @expert @ExpertOutput[%cta*%TK+%k, 0]<1xH> by %producer : tensor<1xHxbf16> scope<pipeline>
    %prob, !prob_ready = flow.load_async @prob @Probabilities[%cta, %k]<1x1> by %producer : tensor<1x1xbf16> scope<pipeline>
    %expert_fp32 = flow.arithmetic @expert_fp32 implements<@expert_fp32> reads[%expert] after[@expert.complete:data] : tensor<1xHxfp32> scope<pipeline>
    %prob_fp32 = flow.arithmetic @prob_fp32 implements<@prob_fp32> reads[%prob] after[@prob.complete:data] : tensor<1x1xfp32> scope<pipeline>
    %multiply = flow.arithmetic @multiply implements<@multiply> reads[%expert_fp32, %prob_fp32] after[@expert_fp32.complete:data, @prob_fp32.complete:data] : tensor<1xHxfp32> scope<pipeline>
    %add = flow.arithmetic @add implements<@add> reads[%multiply] after[@multiply.complete:data, @zero.complete:acc_state, @add.complete:acc_state] : tensor<1xHxfp32> scope<pipeline>
  }
  %cast = flow.arithmetic @cast implements<@cast> reads[%add] after[@add.complete:last] : tensor<1xHxbf16> scope<epilogue>
  !output_done = flow.store_async @output reads[%cast] cast<bf16> to @Output[%cta, 0]<1xH> by %producer after[@cast.complete:data] scope<epilogue>
}
mapping.program @weighted_direct_mapping flow<@weighted_direct_flow> target<sm90> placement<round_robin> {
  map.execute @producer capability<bulk_copy> -> @TMA
  map.execute @matrix capability<matrix.mma> -> @WGMMA
  map.store @scratch -> @SMEM
}
