algo.kernel @fa3_reference(%Q: tensor<QROWSxDxbf16>, %K: tensor<CACHE_ROWSxDxbf16>, %V: tensor<CACHE_ROWSxDxbf16>)
    -> (%O: tensor<QROWSxDxbf16>) {
  static.param %B : index
  static.param %HQ : index
  static.param %HKV : index
  static.param %D : index
  static.param %Q_LENGTH : index
  static.param %Q_TILE : index
  static.param %TILE : index
  static.param %NUM_SMS : index
  static.param %CONTEXTS : index_list
  algo.domain %row in [0, 1)
  algo.compute @max_init result<%max_init> semantics<-inf>
  algo.op @max_init category<arithmetic> cost<simple> dtype<fp32> inputs[] output[%max_init] reduction[]
  algo.compute @sum_init result<%sum_init> semantics<0>
  algo.op @sum_init category<arithmetic> cost<simple> dtype<fp32> inputs[] output[%sum_init] reduction[]
  algo.compute @out_init result<%out_init> semantics<zeros(FR,D)>
  algo.op @out_init category<arithmetic> cost<simple> dtype<fp32> inputs[] output[%out_init] reduction[]
  algo.compute @qk result<%qk> semantics<sum_D(Q * K.transpose)>
  algo.op @qk category<matrix> cost<none> dtype<fp32> inputs[%query, %key] output[%qk] reduction[]
  algo.compute @score result<%score> semantics<qk / sqrt(D)>
  algo.op @score category<arithmetic> cost<multiply> dtype<fp32> inputs[%qk] output[%score] reduction[]
  algo.compute @tile_max result<%tile_max> semantics<max_KV(score)>
  algo.op @tile_max category<reduction> cost<extremum> dtype<fp32> inputs[%score] output[%tile_max] reduction[]
  algo.compute @max_new result<%max_new> semantics<max(m_prev,tile_max)>
  algo.op @max_new category<arithmetic> cost<simple> dtype<fp32> inputs[%tile_max] output[%max_new] reduction[]
  algo.compute @alpha_delta result<%alpha_delta> semantics<m_prev-max_new>
  algo.op @alpha_delta category<arithmetic> cost<simple> dtype<fp32> inputs[%max_new] output[%alpha_delta] reduction[]
  algo.compute @alpha result<%alpha> semantics<exp(alpha_delta)>
  algo.op @alpha category<special_function> cost<exponential> dtype<fp32> inputs[%alpha_delta] output[%alpha] reduction[]
  algo.compute @delta result<%delta> semantics<score-max_new>
  algo.op @delta category<arithmetic> cost<simple> dtype<fp32> inputs[%score, %max_new] output[%delta] reduction[]
  algo.compute @probability result<%probability> semantics<exp(delta)>
  algo.op @probability category<special_function> cost<exponential> dtype<fp32> inputs[%delta] output[%probability] reduction[]
  algo.compute @prob_cast result<%prob_cast> semantics<cast_bf16(probability)>
  algo.op @prob_cast category<convert> cost<none> dtype<bf16> inputs[%probability] output[%prob_cast] reduction[]
  algo.compute @prob_sum result<%prob_sum> semantics<sum_KV(probability)>
  algo.op @prob_sum category<reduction> cost<sum> dtype<fp32> inputs[%probability] output[%prob_sum] reduction[]
  algo.compute @sum_scaled result<%sum_scaled> semantics<l_prev*alpha>
  algo.op @sum_scaled category<arithmetic> cost<multiply> dtype<fp32> inputs[%alpha] output[%sum_scaled] reduction[]
  algo.compute @sum_new result<%sum_new> semantics<sum_scaled+prob_sum>
  algo.op @sum_new category<arithmetic> cost<simple> dtype<fp32> inputs[%sum_scaled, %prob_sum] output[%sum_new] reduction[]
  algo.compute @out_scaled result<%out_scaled> semantics<o_prev*alpha>
  algo.op @out_scaled category<arithmetic> cost<multiply> dtype<fp32> inputs[%alpha] output[%out_scaled] reduction[]
  algo.compute @pv result<%pv> semantics<out_scaled + sum_KV(probability * V)>
  algo.op @pv category<matrix> cost<none> dtype<fp32> inputs[%prob_cast, %value, %out_scaled] output[%pv] reduction[]
  algo.compute @normalize result<%normalize> semantics<o_final/l_final>
  algo.op @normalize category<arithmetic> cost<divide> dtype<fp32> inputs[%pv, %sum_new] output[%normalize] reduction[]
  algo.compute @cast result<%cast> semantics<cast_bf16(normalize)>
  algo.op @cast category<convert> cost<none> dtype<bf16> inputs[%normalize] output[%cast] reduction[]
  algo.compute @contract_O result<%O> semantics<for each actual query q: O[b,h,q,:] = cast_bf16(softmax(Q[b,h,q,:] @ K[b,h//(HQ/HKV),:,:].T/sqrt(D)) @ V[b,h//(HQ/HKV),:,:])>
}
