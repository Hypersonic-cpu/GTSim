flow.kernel @fa3_gqa_decode_split_flow schedule<explicit> target<%TARGET> {
  static.param %B : index
  static.param %HQ : index
  static.param %HKV : index
  static.param %D : index
  static.param %R : index
  static.param %S : index
  static.param %TILE : index
  static.param %STAGES : index
  static.param %NUM_SMS : index
  static.param %CONTEXTS : index_list
  static.let %G = floordiv(%HQ,%HKV)
  static.let %QB = ceildiv(%G,%R)
  static.let %CTAS = %B*%HKV*%QB*%S
  static.let %QROWS = %B*%HQ
  static.let %CACHE_ROWS = (sum(%CONTEXTS)+%B)*%HKV
  static.let %PART_ROWS = %B*%HQ*%S
  static.let %SPLIT = %cta mod %S
  static.let %QBLOCK = floordiv(%cta,%S) mod %QB
  static.let %R_VALID = min(%R,%G-%QBLOCK*%R)
  static.let %KVHEAD = floordiv(%cta,%S*%QB) mod %HKV
  static.let %REQUEST = floordiv(%cta,%S*%QB*%HKV)
  static.let %HEAD0 = %KVHEAD*%G+%QBLOCK*%R
  static.let %QBASE = %REQUEST*%HQ+%HEAD0
  static.let %LENGTH = %CONTEXTS[%REQUEST]+1
  static.let %START = floordiv(%LENGTH*%SPLIT,%S)
  static.let %END = floordiv(%LENGTH*(%SPLIT+1),%S)
  static.let %VALID = min(%TILE,%END-%START-%k*%TILE)
  static.let %CACHE_BASE = (prefix_sum(%CONTEXTS,%REQUEST)+%REQUEST)*%HKV+%KVHEAD*%LENGTH
  static.let %PART_BASE = (%REQUEST*%S+%SPLIT)*%HQ+%HEAD0
  static.let %ROW_GROUP = ceildiv(%R_VALID,%CONSUMER_WARPS)
  static.let %ROWS = min(%ROW_GROUP,%R_VALID-%executor*%ROW_GROUP)
  static.let %ACTIVE_WARPS = ceildiv(%R_VALID,%ROW_GROUP)
  static.let %M_TILES = ceildiv(%R_VALID,%MMA_M)
  static.let %PAD_Q_ELEMENTS = %M_TILES*%MMA_M*ceildiv(%D,%MMA_K)*%MMA_K-%R_VALID*%D
  static.let %PAD_K_ELEMENTS = ceildiv(%VALID,%MMA_N)*%MMA_N*ceildiv(%D,%MMA_K)*%MMA_K-%VALID*%D
  static.let %PAD_V_ELEMENTS = ceildiv(%VALID,%MMA_K)*%MMA_K*ceildiv(%D,%MMA_N)*%MMA_N-%VALID*%D
  static.let %MMA_WARP_M = floordiv(%MMA_M,%WARPGROUP)
  flow.tensor @Q : tensor<QROWSxDx%QKV_DTYPE, row_major>
  flow.tensor @K : tensor<CACHE_ROWSxDx%QKV_DTYPE, row_major>
  flow.tensor @V : tensor<CACHE_ROWSxDx%QKV_DTYPE, row_major>
  flow.tensor @Partial : tensor<PART_ROWSxDxfp32, row_major>
  flow.tensor @LSE : tensor<PART_ROWSx1xfp32, row_major>
  flow.schedule_config tile(%Rx%TILEx%D) stages(%STAGES) warps(%WARPS) consumer_warps(%CONSUMER_WARPS) producer_warp(%PRODUCER_WARP) warpgroup(%WARPGROUP) matrix_tile(%MMA_Mx%MMA_Nx%MMA_K)
  flow.loop @cta %cta = 0 to %CTAS step 1
  flow.loop @wave %wave = 0 to 1 step 1
  flow.executor %producer role<producer> organization<independent>
  flow.executor %matrix role<matrix> organization<cooperative>
  flow.buffer %q slots(1) access<read_write> : bytes_per_slot<%Q_BYTES>
  flow.buffer %k_stage slots(%STAGES) access<read_write> : bytes_per_slot<%K_BYTES>
  flow.buffer %v_stage slots(%STAGES) access<read_write> : bytes_per_slot<%V_BYTES>
  flow.buffer %barriers slots(1) access<read_write> : bytes_per_slot<%BARRIER_BYTES>
  static.if <%k>=%STAGES> {
    flow.dependency_rule @reuse_k from[@qk.complete] at[%wave=%wave, %k=%k-%STAGES] select<all>
    flow.dependency_rule @reuse_v from[@pv.complete] at[%wave=%wave, %k=%k-%STAGES] select<all>
  }
  static.if <%fragment>0> {
    flow.dependency_rule @fragment from[@qk.complete, @pv.complete] at[%wave=%wave, %k=%k, %executor=%executor, %fragment=%fragment-1] select<all>
  }
  flow.dependency_rule @lane from[@score.complete, @tile_max.complete, @max_new.complete, @alpha_delta.complete, @alpha.complete, @delta.complete, @probability.complete, @prob_sum.complete, @sum_scaled.complete, @sum_new.complete, @out_scaled.complete, @normalize.complete, @cast.complete, @log_sum.complete, @lse.complete, @qk.complete, @pv.complete, @prob_cast.complete] at[%wave = %wave, %k = %k, %executor = %executor] select<all>
  flow.dependency_rule @last from[@pv.complete, @sum_new.complete, @max_new.complete] at[%wave=%wave, %k=ceildiv(%END-%START,%TILE)-1, %executor=%executor] select<all>
  static.if <%PAD_Q_ELEMENTS != 0> {
    flow.dependency_rule @padding from[@pad_q.complete] at[%wave=%wave] select<all>
  }
  static.if <%PAD_K_ELEMENTS != 0> {
    flow.dependency_rule @padding from[@pad_k.complete] at[%wave=%wave, %k=%k] select<all>
  }
  static.if <%PAD_V_ELEMENTS != 0> {
    flow.dependency_rule @padding from[@pad_v.complete] at[%wave=%wave, %k=%k] select<all>
  }
  flow.dependency_rule @packed_rows from[@prob_cast.complete, @out_scaled.complete] at[%wave=%wave, %k=%k] select<all>
  flow.dependency_rule @output_rows from[@normalize.complete, @lse.complete] at[%wave=%wave] select<all>
  static.if <%k==0> {
    flow.dependency_rule @state_max_new from[@max_init.complete] at[%wave = %wave, %executor = %executor] select<all>
  }
  static.if <%k>0> {
    flow.dependency_rule @state_max_new from[@max_new.complete] at[%wave = %wave, %k = %k-1, %executor = %executor] select<all>
  }
  static.if <%k==0> {
    flow.dependency_rule @state_sum_new from[@sum_init.complete] at[%wave = %wave, %executor = %executor] select<all>
  }
  static.if <%k>0> {
    flow.dependency_rule @state_sum_new from[@sum_new.complete] at[%wave = %wave, %k = %k-1, %executor = %executor] select<all>
  }
  static.if <%k==0> {
    flow.dependency_rule @state_pv from[@out_init.complete] at[%wave = %wave, %executor = %executor] select<all>
  }
  static.if <%k>0> {
    flow.dependency_rule @state_pv from[@pv.complete] at[%wave = %wave, %k = %k-1, %executor = %executor] select<all>
  }
  %query, !query_ready = flow.load_async @query @Q[%QBASE, 0]<R_VALIDxD> by %producer requires<bulk_copy_exact> : tensor<R_VALIDxDx%QKV_DTYPE> scope<prologue>
  %pad_q = flow.arithmetic @pad_q implements<@pad_q> reads[] : tensor<1xPAD_Q_ELEMENTSx%QKV_DTYPE> scope<prologue> static.if<%PAD_Q_ELEMENTS != 0>
  %max_init = flow.arithmetic @max_init implements<@max_init> reads[] : tensor<ROWSx1xfp32> scope<prologue> iterate<%executor = 0 to %ACTIVE_WARPS> static.args<value=-inf>
  %sum_init = flow.arithmetic @sum_init implements<@sum_init> reads[] : tensor<ROWSx1xfp32> scope<prologue> iterate<%executor = 0 to %ACTIVE_WARPS> static.args<value=0>
  %out_init = flow.arithmetic @out_init implements<@out_init> reads[] : tensor<ROWSxDxfp32> scope<prologue> iterate<%executor = 0 to %ACTIVE_WARPS> static.args<value=0>
  flow.pipeline @loop %k = 0 to ceildiv(%END-%START,%TILE) step 1 depth(%STAGES) generation_counts_per_wave[1] {
    %key, !key_ready = flow.load_async @key @K[%CACHE_BASE+%START+%k*%TILE, 0]<VALIDxD> by %producer slots[%k_stage.s] requires<bulk_copy_exact> after[@qk.complete:reuse_k] : tensor<VALIDxDx%QKV_DTYPE> scope<pipeline>
    %value, !value_ready = flow.load_async @value @V[%CACHE_BASE+%START+%k*%TILE, 0]<VALIDxD> by %producer slots[%v_stage.s] requires<bulk_copy_exact> after[@pv.complete:reuse_v] : tensor<VALIDxDx%QKV_DTYPE> scope<pipeline>
    %pad_k = flow.arithmetic @pad_k implements<@pad_k> reads[] after[@qk.complete:reuse_k] : tensor<1xPAD_K_ELEMENTSx%QKV_DTYPE> scope<pipeline> static.if<%PAD_K_ELEMENTS != 0>
    %pad_v = flow.arithmetic @pad_v implements<@pad_v> reads[] after[@pv.complete:reuse_v] : tensor<1xPAD_V_ELEMENTSx%QKV_DTYPE> scope<pipeline> static.if<%PAD_V_ELEMENTS != 0>
    %qk = flow.matmul @qk implements<@qk> reads[%query, %key] after[@query.complete:data, @pad_q.complete:padding, @key.complete:data, @pad_k.complete:padding, @qk.complete:fragment] : tensor<R_VALIDxVALIDxfp32> scope<pipeline> iterate<%executor = 0 to %CONSUMER_WARPS> iterate<%fragment = 0 to %M_TILES*ceildiv(%D,%MMA_K)*ceildiv(%VALID,%MMA_N)> work<MMA_WARP_MxMMA_N>
    %score = flow.arithmetic @score implements<@score> reads[%qk] after[@qk.complete:lane] : tensor<ROWSxVALIDxfp32> scope<pipeline> iterate<%executor = 0 to %ACTIVE_WARPS>
    %tile_max = flow.reduction @tile_max implements<@tile_max> reads[%score] after[@score.complete:lane] : tensor<ROWSx1xfp32> scope<pipeline> iterate<%executor = 0 to %ACTIVE_WARPS> work<ROWSxVALID>
    %max_new = flow.arithmetic @max_new implements<@max_new> reads[%tile_max] after[@tile_max.complete:lane, @max_init.complete:state_max_new, @max_new.complete:state_max_new] : tensor<ROWSx1xfp32> scope<pipeline> iterate<%executor = 0 to %ACTIVE_WARPS>
    %alpha_delta = flow.arithmetic @alpha_delta implements<@alpha_delta> reads[%max_new] after[@max_new.complete:lane, @max_init.complete:state_max_new, @max_new.complete:state_max_new] : tensor<ROWSx1xfp32> scope<pipeline> iterate<%executor = 0 to %ACTIVE_WARPS> static.args<first=%k==0>
    %alpha = flow.special_function @alpha implements<@alpha> reads[%alpha_delta] after[@alpha_delta.complete:lane] : tensor<ROWSx1xfp32> scope<pipeline> iterate<%executor = 0 to %ACTIVE_WARPS>
    %delta = flow.arithmetic @delta implements<@delta> reads[%score, %max_new] after[@score.complete:lane, @max_new.complete:lane] : tensor<ROWSxVALIDxfp32> scope<pipeline> iterate<%executor = 0 to %ACTIVE_WARPS>
    %probability = flow.special_function @probability implements<@probability> reads[%delta] after[@delta.complete:lane] : tensor<ROWSxVALIDxfp32> scope<pipeline> iterate<%executor = 0 to %ACTIVE_WARPS>
    %prob_cast = flow.arithmetic @prob_cast implements<@prob_cast> reads[%probability] after[@probability.complete:lane] : tensor<ROWSxVALIDx%QKV_DTYPE> scope<pipeline> iterate<%executor = 0 to %ACTIVE_WARPS>
    %prob_sum = flow.reduction @prob_sum implements<@prob_sum> reads[%probability] after[@probability.complete:lane] : tensor<ROWSx1xfp32> scope<pipeline> iterate<%executor = 0 to %ACTIVE_WARPS> work<ROWSxVALID>
    %sum_scaled = flow.arithmetic @sum_scaled implements<@sum_scaled> reads[%alpha] after[@alpha.complete:lane, @sum_init.complete:state_sum_new, @sum_new.complete:state_sum_new] : tensor<ROWSx1xfp32> scope<pipeline> iterate<%executor = 0 to %ACTIVE_WARPS>
    %sum_new = flow.arithmetic @sum_new implements<@sum_new> reads[%sum_scaled, %prob_sum] after[@sum_scaled.complete:lane, @prob_sum.complete:lane] : tensor<ROWSx1xfp32> scope<pipeline> iterate<%executor = 0 to %ACTIVE_WARPS>
    %out_scaled = flow.arithmetic @out_scaled implements<@out_scaled> reads[%alpha] after[@alpha.complete:lane, @out_init.complete:state_pv, @pv.complete:state_pv] : tensor<ROWSxDxfp32> scope<pipeline> iterate<%executor = 0 to %ACTIVE_WARPS>
    %pv = flow.matmul @pv implements<@pv> reads[%prob_cast, %value, %out_scaled] after[@prob_cast.complete:packed_rows, @value.complete:data, @pad_v.complete:padding, @out_scaled.complete:packed_rows, @pv.complete:fragment] : tensor<R_VALIDxDxfp32> scope<pipeline> iterate<%executor = 0 to %CONSUMER_WARPS> iterate<%fragment = 0 to %M_TILES*ceildiv(%VALID,%MMA_K)*ceildiv(%D,%MMA_N)> work<MMA_WARP_MxMMA_N>
  }
  %normalize = flow.arithmetic @normalize implements<@normalize> reads[%pv, %sum_new] after[@pv.complete:last, @sum_new.complete:last] : tensor<ROWSxDxfp32> scope<epilogue> iterate<%executor = 0 to %ACTIVE_WARPS>
  %log_sum = flow.special_function @log_sum implements<@log_sum> reads[%sum_new] after[@sum_new.complete:last] : tensor<ROWSx1xfp32> scope<epilogue> iterate<%executor = 0 to %ACTIVE_WARPS>
  %lse = flow.arithmetic @lse implements<@lse> reads[%max_new, %log_sum] after[@max_new.complete:last, @log_sum.complete:data] : tensor<ROWSx1xfp32> scope<epilogue> iterate<%executor = 0 to %ACTIVE_WARPS>
  !partial_done = flow.store_async @partial_out reads[%normalize] cast<fp32> to @Partial[%PART_BASE,0]<R_VALIDxD> by %producer requires<bulk_copy_exact> after[@normalize.complete:output_rows] scope<epilogue>
  !lse_done = flow.store_async @lse_out reads[%lse] cast<fp32> to @LSE[%PART_BASE,0]<R_VALIDx1> by %producer requires<bulk_copy_exact> after[@lse.complete:output_rows] scope<epilogue>
}
mapping.program @fa3_gqa_decode_split_mapping flow<@fa3_gqa_decode_split_flow> target<%TARGET> placement<round_robin> {
  map.execute @producer capability<bulk_copy> -> @TMA
  map.execute @matrix capability<matrix.mma> -> @WGMMA
  map.store @q -> @SMEM
  map.store @k_stage -> @SMEM
  map.store @v_stage -> @SMEM
  map.store @barriers -> @SMEM
}
