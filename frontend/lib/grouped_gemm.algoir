algo.kernel @grouped_gemm(%A: tensor<A_ROWSxKxbf16>, %B: tensor<WEIGHT_ROWSxNxbf16>)
    -> (%C: tensor<MxNxbf16>) {
  static.param %M : index
  static.param %N : index
  static.param %K : index
  static.param %NUM_SMS : index
  static.param %E : index
  static.param %IDS : index_list
  static.param %A_MAP : index_list
  static.param %C_MAP : index_list
  static.param %A_ROWS : index
  static.require <%N divisible_by 64, %K divisible_by 16>
  algo.domain %row in [0, 1)
  algo.compute @matmul result<%matmul> semantics<sum_k(cast_fp32(A[A_MAP[s],k])*cast_fp32(B[IDS[s]*K+k,n]))>
  algo.op @matmul category<matrix> cost<none> dtype<fp32> inputs[%A, %B] output[%matmul] reduction[]
  algo.compute @cast_output result<%cast_output> semantics<cast_bf16(matmul)>
  algo.op @cast_output category<convert> cost<none> dtype<bf16> inputs[%matmul] output[%cast_output] reduction[]
  algo.compute @contract_C result<%C> semantics<for each assignment s: C[C_MAP[s],n] = cast_bf16(sum_k(cast_fp32(A[A_MAP[s],k])*cast_fp32(B[IDS[s]*K+k,n])))>
}
