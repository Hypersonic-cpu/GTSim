{
  "name": "gemm",
  "cmd": "./build/gtsim_gemm configs/v0.1.0/h100-sxm.yaml ${m} ${n} ${k} --memory-config configs/memconf/${memconf_yaml}.yaml --stages ${stages} --bm ${bm} --bn ${bn} --bk ${bk}",
  "arch": {
    "memconf_yaml": [
      "cascaded-5F5M",
      "colocated-3F2M",
      "full-hbm"
    ],
    "bm": [ "64", "128" ],
    "bn": [ "128", "256" ],
    "bk": [ "64", "128" ]
  },
  "outfmt": "_${memconf_yaml}_${m}-${n}-${k}_b${bm}-${bn}-${bk}_stg${stages}"
}
