                                for out_proj_k_1 in T.serial(128, annotations={"gtsim.reduction_tile": 1}):
                                    with T.sblock("out_proj_acc"):
                                        v_b = T.axis.spatial(1, 0)
                                        v_j = T.axis.spatial(4096, b_j_fused_0 * 64 + b_j_fused_1_0 * 32 + b_j_fused_1_1 * 32 + b_j_fused_1_2)
                                        v_out_proj_k = T.axis.reduce(4096, out_proj_k_0 * 128 + out_proj_k_1)
                                        T.reads(gated_norm[v_b, v_out_proj_k], W_out[v_out_proj_k, v_j])
                                        T.writes(out_proj_acc[v_b, v_j])
                                        T.sblock_attr({"gtsim.register_stages": 1})
                                        with T.init():
                                            out_proj_acc[v_b, v_j] = T.float32(0.0)
                                        out_proj_acc[v_b, v_j] = out_proj_acc[v_b, v_j] + T.Cast("float32", gated_norm[v_b, v_out_proj_k]) * T.Cast("float32", W_out[v_out_proj_k, v_j])
            for b_j_fused_0 in T.thread_binding(64, thread="blockIdx.x"):
                for b_j_fused_1_0 in T.thread_binding(2, thread="threadIdx.y"):
                    for b_j_fused_1_1 in T.serial(1, annotations={"gtsim.output_vector": 1}):
                        for b_j_fused_1_2 in T.thread_binding(32, thread="threadIdx.x"):
                            with T.sblock("out_proj"):
                                v_b = T.axis.spatial(1, 0)
                                v_j = T.axis.spatial(4096, b_j_fused_0 * 64 + b_j_fused_1_0 * 32 + b_j_fused_1_1 * 32 + b_j_fused_1_2)
                                T.reads(out_proj_acc[v_b, v_j])
                                T.writes(out_proj[v_b, v_j])
                                T.sblock_attr({"gtsim.register_stages": 1})
                                out_proj[v_b, v_j] = T.Cast("bfloat16", out_proj_acc[v_b, v_j])
            for b_d_fused_0 in T.thread_binding(64, thread="blockIdx.x"):
                for b_d_fused_1_0 in T.thread_binding(2, thread="threadIdx.y"):
