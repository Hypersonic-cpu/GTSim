                                        v_j = T.axis.spatial(4096, b_j_fused_0 * 64 + b_j_fused_1_0 * 32 + b_j_fused_1_1 * 32 + b_j_fused_1_2)
                                        v_down_k = T.axis.reduce(12288, down_k_0 * 128 + down_k_1)
                                        T.reads(swiglu[v_b, v_down_k], W_down[v_down_k, v_j])
                                        T.writes(down_acc[v_b, v_j])
                                        T.sblock_attr({"gtsim.register_stages": 1})
                                        with T.init():
