                                v_j = T.axis.spatial(4096, b_j_fused_0 * 64 + b_j_fused_1_0 * 32 + b_j_fused_1_1 * 32 + b_j_fused_1_2)
                                T.reads(down_acc[v_b, v_j])
                                T.writes(down[v_b, v_j])
                                T.sblock_attr({"gtsim.register_stages": 1})
                                down[v_b, v_j] = T.Cast("bfloat16", down_acc[v_b, v_j])
            for b_d_fused_0 in T.thread_binding(64, thread="blockIdx.x"):
                for b_d_fused_1_0 in T.thread_binding(2, thread="threadIdx.y"):
                    for b_d_fused_1_1 in T.serial(1, annotations={"gtsim.output_vector": 1}):
                        for b_d_fused_1_2 in T.thread_binding(32, thread="threadIdx.x"):
                            with T.sblock("Output"):
                                v_b = T.axis.spatial(1, 0)
                                v_d = T.axis.spatial(4096, b_d_fused_0 * 64 + b_d_fused_1_0 * 32 + b_d_fused_1_1 * 32 + b_d_fused_1_2)
                                T.reads(residual[v_b, v_d], down[v_b, v_d])
                                T.writes(Output[v_b, v_d])
                                T.sblock_attr({"gtsim.register_stages": 1})
                                Output[v_b, v_d] = T.Cast("bfloat16", T.Cast("float32", residual[v_b, v_d]) + T.Cast("float32", down[v_b, v_d]))
            for b_c_t_fused_0 in T.thread_binding(512, thread="blockIdx.x"):
                for b_c_t_fused_1_0 in T.thread_binding(2, thread="threadIdx.y"):
                    for b_c_t_fused_1_1 in T.serial(1, annotations={"gtsim.output_vector": 1}):
                        for b_c_t_fused_1_2 in T.thread_binding(32, thread="threadIdx.x"):
                            with T.sblock("NextConvState"):
                                v_b = T.axis.spatial(1, 0)
                                v_c = T.axis.spatial(8192, (b_c_t_fused_0 * 64 + b_c_t_fused_1_0 * 32 + b_c_t_fused_1_1 * 32 + b_c_t_fused_1_2) // 4)
                                v_t = T.axis.spatial(4, (b_c_t_fused_0 * 64 + b_c_t_fused_1_0 * 32 + b_c_t_fused_1_1 * 32 + b_c_t_fused_1_2) % 4)
                                T.reads(ConvState[v_b, v_c, v_t + 1], qkvz[v_b, v_c])
                                T.writes(NextConvState[v_b, v_c, v_t])
                                T.sblock_attr({"gtsim.register_stages": 1})
                                NextConvState[v_b, v_c, v_t] = T.if_then_else(v_t < 3, ConvState[v_b, v_c, v_t + 1], qkvz[v_b, v_c])