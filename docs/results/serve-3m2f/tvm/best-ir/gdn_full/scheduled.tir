                                        v_post_norm_r = T.axis.reduce(4096, post_norm_r_0 * 128 + post_norm_r_1)
                                        T.where(b_fused_0 * 64 + ((b_fused_1_0 + b_fused_1_1) * 32 + b_fused_1_2) < 1)
                                        T.reads(residual[v_b, v_post_norm_r])
                                        T.writes(post_norm_sum[v_b])
                                        T.sblock_attr({"gtsim.register_stages": 1})
                                        with T.init():
