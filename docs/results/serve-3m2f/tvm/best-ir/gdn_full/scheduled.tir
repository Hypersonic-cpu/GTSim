                                        v_h = T.axis.spatial(32, (b_h_j_fused_0 * 64 + b_h_j_fused_1_0 * 32 + b_h_j_fused_1_1 * 32 + b_h_j_fused_1_2) // 128)
                                        v_j = T.axis.spatial(128, (b_h_j_fused_0 * 64 + b_h_j_fused_1_0 * 32 + b_h_j_fused_1_1 * 32 + b_h_j_fused_1_2) % 128)
                                        v_out_k = T.axis.reduce(128, out_k_0 * 128 + out_k_1)
                                        T.reads(q_norm[v_b, v_h // 2, v_out_k], NextState[v_b, v_h, v_out_k, v_j])
                                        T.writes(attn_acc[v_b, v_h, v_j])
                                        T.sblock_attr({"gtsim.register_stages": 1})
                                        with T.init():
                                            attn_acc[v_b, v_h, v_j] = T.float32(0.0)
                                        attn_acc[v_b, v_h, v_j] = attn_acc[v_b, v_h, v_j] + q_norm[v_b, v_h // 2, v_out_k] * NextState[v_b, v_h, v_out_k, v_j]
            for b_h_j_fused_0 in T.thread_binding(64, thread="blockIdx.x"):
                for b_h_j_fused_1_0 in T.thread_binding(2, thread="threadIdx.y"):
