                                        v_gate_up_k = T.axis.reduce(4096, gate_up_k_0 * 128 + gate_up_k_1)
                                        T.reads(post_norm[v_b, v_gate_up_k], W_gate_up[v_gate_up_k, v_j])
                                        T.writes(gate_up_acc[v_b, v_j])
                                        T.sblock_attr({"gtsim.register_stages": 1})
                                        with T.init():
