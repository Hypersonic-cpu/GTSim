                        for b_d_fused_1_2 in T.thread_binding(32, thread="threadIdx.x"):
                            with T.sblock("residual"):
                                v_b = T.axis.spatial(1, 0)
                                v_d = T.axis.spatial(4096, b_d_fused_0 * 64 + b_d_fused_1_0 * 32 + b_d_fused_1_1 * 32 + b_d_fused_1_2)
                                T.reads(X[v_b, v_d], out_proj[v_b, v_d])
                                T.writes(residual[v_b, v_d])
                                T.sblock_attr({"gtsim.register_stages": 1})
                                residual[v_b, v_d] = T.Cast("bfloat16", T.Cast("float32", X[v_b, v_d]) + T.Cast("float32", out_proj[v_b, v_d]))
            for b_fused_0 in T.thread_binding(1, thread="blockIdx.x"):
