                                v_h = T.axis.spatial(32, (b_h_j_fused_0 * 64 + b_h_j_fused_1_0 * 32 + b_h_j_fused_1_1 * 32 + b_h_j_fused_1_2) // 128)
                                v_j = T.axis.spatial(128, (b_h_j_fused_0 * 64 + b_h_j_fused_1_0 * 32 + b_h_j_fused_1_1 * 32 + b_h_j_fused_1_2) % 128)
                                T.reads(attn_acc[v_b, v_h, v_j])
                                T.writes(attn[v_b, v_h, v_j])
                                T.sblock_attr({"gtsim.register_stages": 1})
                                attn[v_b, v_h, v_j] = T.Cast("bfloat16", attn_acc[v_b, v_h, v_j])
            for b_h_fused_0 in T.thread_binding(1, thread="blockIdx.x"):
                for out_norm_d_0 in range(1):
                    for b_h_fused_1_0 in T.thread_binding(2, thread="threadIdx.y"):
                        for b_h_fused_1_1 in T.serial(1, annotations={"gtsim.output_vector": 1}):
                            for b_h_fused_1_2 in T.thread_binding(32, thread="threadIdx.x"):
                                for out_norm_d_1 in T.serial(128, annotations={"gtsim.reduction_tile": 1}):
                                    with T.sblock("gated_sum"):
                                        v_b = T.axis.spatial(1, 0)
                                        v_h = T.axis.spatial(32, b_h_fused_0 * 64 + b_h_fused_1_0 * 32 + b_h_fused_1_1 * 32 + b_h_fused_1_2)
                                        v_out_norm_d = T.axis.reduce(128, out_norm_d_0 * 128 + out_norm_d_1)
                                        T.where(b_h_fused_0 * 64 + ((b_h_fused_1_0 + b_h_fused_1_1) * 32 + b_h_fused_1_2) < 32)
                                        T.reads(attn[v_b, v_h, v_out_norm_d])
                                        T.writes(gated_sum[v_b, v_h])
                                        T.sblock_attr({"gtsim.register_stages": 1})
                                        with T.init():
                                            gated_sum[v_b, v_h] = T.float32(0.0)
                                        gated_sum[v_b, v_h] = gated_sum[v_b, v_h] + T.Cast("float32", attn[v_b, v_h, v_out_norm_d]) * T.Cast("float32", attn[v_b, v_h, v_out_norm_d])
            for b_d_fused_0 in T.thread_binding(64, thread="blockIdx.x"):
                for b_d_fused_1_0 in T.thread_binding(2, thread="threadIdx.y"):
                    for b_d_fused_1_1 in T.serial(1, annotations={"gtsim.output_vector": 1}):
                        for b_d_fused_1_2 in T.thread_binding(32, thread="threadIdx.x"):
                            with T.sblock("gated_norm"):
                                v_b = T.axis.spatial(1, 0)
                                v_d = T.axis.spatial(4096, b_d_fused_0 * 64 + b_d_fused_1_0 * 32 + b_d_fused_1_1 * 32 + b_d_fused_1_2)
                                T.reads(attn[v_b, v_d // 128, v_d % 128], gated_sum[v_b, v_d // 128], W_gated_norm[v_d % 128], qkvz[v_b, v_d + 8192])
                                T.writes(gated_norm[v_b, v_d])
                                T.sblock_attr({"gtsim.register_stages": 1})
                                gated_norm[v_b, v_d] = T.Cast("bfloat16", T.Cast("float32", attn[v_b, v_d // 128, v_d % 128]) / T.sqrt(gated_sum[v_b, v_d // 128] / T.float32(128.0) + T.float32(9.9999999999999995e-07)) * T.Cast("float32", W_gated_norm[v_d % 128]) * T.Cast("float32", qkvz[v_b, v_d + 8192]) / (T.float32(1.0) + T.exp(T.Cast("float32", qkvz[v_b, v_d + 8192]) * T.float32(-1.0))))
            for b_j_fused_0 in T.thread_binding(64, thread="blockIdx.x"):
                for out_proj_k_0 in range(32):
