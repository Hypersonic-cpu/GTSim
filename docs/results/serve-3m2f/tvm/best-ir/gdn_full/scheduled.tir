                                        v_h = T.axis.spatial(32, (b_h_j_fused_0 * 64 + b_h_j_fused_1_0 * 32 + b_h_j_fused_1_1 * 32 + b_h_j_fused_1_2) // 128)
                                        v_j = T.axis.spatial(128, (b_h_j_fused_0 * 64 + b_h_j_fused_1_0 * 32 + b_h_j_fused_1_1 * 32 + b_h_j_fused_1_2) % 128)
                                        v_predict_k = T.axis.reduce(128, predict_k_0 * 128 + predict_k_1)
                                        T.reads(decayed_state[v_b, v_h, v_predict_k, v_j], k_norm[v_b, v_h // 2, v_predict_k])
                                        T.writes(prediction[v_b, v_h, v_j])
                                        T.sblock_attr({"gtsim.register_stages": 1})
                                        with T.init():
                                            prediction[v_b, v_h, v_j] = T.float32(0.0)
                                        prediction[v_b, v_h, v_j] = prediction[v_b, v_h, v_j] + decayed_state[v_b, v_h, v_predict_k, v_j] * k_norm[v_b, v_h // 2, v_predict_k]
            for b_h_j_fused_0 in T.thread_binding(64, thread="blockIdx.x"):
                for b_h_j_fused_1_0 in T.thread_binding(2, thread="threadIdx.y"):
                    for b_h_j_fused_1_1 in T.serial(1, annotations={"gtsim.output_vector": 1}):
                        for b_h_j_fused_1_2 in T.thread_binding(32, thread="threadIdx.x"):
                            with T.sblock("delta"):
                                v_b = T.axis.spatial(1, 0)
                                v_h = T.axis.spatial(32, (b_h_j_fused_0 * 64 + b_h_j_fused_1_0 * 32 + b_h_j_fused_1_1 * 32 + b_h_j_fused_1_2) // 128)
                                v_j = T.axis.spatial(128, (b_h_j_fused_0 * 64 + b_h_j_fused_1_0 * 32 + b_h_j_fused_1_1 * 32 + b_h_j_fused_1_2) % 128)
                                T.reads(ba[v_b, v_h], conv[v_b, v_h * 128 + v_j + 4096], prediction[v_b, v_h, v_j])
                                T.writes(delta[v_b, v_h, v_j])
                                T.sblock_attr({"gtsim.register_stages": 1})
                                delta[v_b, v_h, v_j] = T.float32(1.0) / (T.float32(1.0) + T.exp(T.Cast("float32", ba[v_b, v_h]) * T.float32(-1.0))) * (T.Cast("float32", T.Cast("bfloat16", conv[v_b, v_h * 128 + v_j + 4096] / (T.float32(1.0) + T.exp(conv[v_b, v_h * 128 + v_j + 4096] * T.float32(-1.0))))) - prediction[v_b, v_h, v_j])
            for b_h_i_j_fused_0 in T.thread_binding(8192, thread="blockIdx.x"):
                for b_h_i_j_fused_1_0 in T.thread_binding(2, thread="threadIdx.y"):
                    for b_h_i_j_fused_1_1 in T.serial(1, annotations={"gtsim.output_vector": 1}):
                        for b_h_i_j_fused_1_2 in T.thread_binding(32, thread="threadIdx.x"):
                            with T.sblock("NextState"):
                                v_b = T.axis.spatial(1, 0)
                                v_h = T.axis.spatial(32, (b_h_i_j_fused_0 * 64 + b_h_i_j_fused_1_0 * 32 + b_h_i_j_fused_1_1 * 32 + b_h_i_j_fused_1_2) // 16384)
                                v_i = T.axis.spatial(128, (b_h_i_j_fused_0 * 64 + b_h_i_j_fused_1_0 * 32 + b_h_i_j_fused_1_1 * 32 + b_h_i_j_fused_1_2) % 16384 // 128)
                                v_j = T.axis.spatial(128, (b_h_i_j_fused_0 * 64 + b_h_i_j_fused_1_0 * 32 + b_h_i_j_fused_1_1 * 32 + b_h_i_j_fused_1_2) % 128)
                                T.reads(decayed_state[v_b, v_h, v_i, v_j], k_norm[v_b, v_h // 2, v_i], delta[v_b, v_h, v_j])
                                T.writes(NextState[v_b, v_h, v_i, v_j])
                                T.sblock_attr({"gtsim.register_stages": 1})
                                NextState[v_b, v_h, v_i, v_j] = decayed_state[v_b, v_h, v_i, v_j] + k_norm[v_b, v_h // 2, v_i] * delta[v_b, v_h, v_j]
            for b_h_j_fused_0 in T.thread_binding(64, thread="blockIdx.x"):
