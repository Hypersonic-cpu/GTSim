                                v_j = T.axis.spatial(24576, b_j_fused_0 * 64 + b_j_fused_1_0 * 32 + b_j_fused_1_1 * 32 + b_j_fused_1_2)
                                T.reads(gate_up_acc[v_b, v_j])
                                T.writes(gate_up[v_b, v_j])
