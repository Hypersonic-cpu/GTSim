# from tvm.script import ir as I
# from tvm.script import tirx as T
# from tvm.tirx.layout import Axis

@I.ir_module
class Module:
    @T.prim_func(s_tir=True)
    def main(X: T.Buffer((1, 4096), "bfloat16"), W_projection: T.Buffer((4096, 24576), "bfloat16"), Output: T.Buffer((1, 24576), "bfloat16")):
        T.func_attr({"gtsim.semantic_tensor_tiers": "{\"Output\": \"HBM\", \"W_projection\": \"HBF\", \"X\": \"HBM\"}", "tirx.noalias": True})
        with T.sblock("root"):
            T.reads()
            T.writes()
            T.sblock_attr({"gtsim.inline_level": 0})
            projection_acc = T.sblock_alloc_buffer((1, 24576))
            for b_j_fused_0 in T.thread_binding(192, thread="blockIdx.x"):
                for k_0 in range(32):
                    for b_j_fused_1_0 in T.thread_binding(4, thread="threadIdx.y"):
                        for b_j_fused_1_1 in T.serial(1, annotations={"gtsim.output_vector": 1}):
                            for b_j_fused_1_2 in T.thread_binding(32, thread="threadIdx.x"):
                                for k_1 in T.serial(128, annotations={"gtsim.reduction_tile": 1}):
                                    with T.sblock("projection_acc"):
                                        v_b = T.axis.spatial(1, 0)
                                        v_j = T.axis.spatial(24576, b_j_fused_0 * 128 + b_j_fused_1_0 * 32 + b_j_fused_1_1 * 32 + b_j_fused_1_2)
                                        v_k = T.axis.reduce(4096, k_0 * 128 + k_1)
                                        T.reads(X[v_b, v_k], W_projection[v_k, v_j])
                                        T.writes(projection_acc[v_b, v_j])
                                        T.sblock_attr({"gtsim.register_stages": 3})
                                        with T.init():
                                            projection_acc[v_b, v_j] = T.float32(0.0)
                                        projection_acc[v_b, v_j] = projection_acc[v_b, v_j] + T.Cast("float32", X[v_b, v_k]) * T.Cast("float32", W_projection[v_k, v_j])
            for b_j_fused_0 in T.thread_binding(192, thread="blockIdx.x"):
                for b_j_fused_1_0 in T.thread_binding(4, thread="threadIdx.y"):
                    for b_j_fused_1_1 in T.serial(1, annotations={"gtsim.output_vector": 1}):
                        for b_j_fused_1_2 in T.thread_binding(32, thread="threadIdx.x"):
                            with T.sblock("Output"):
                                v_b = T.axis.spatial(1, 0)
                                v_j = T.axis.spatial(24576, b_j_fused_0 * 128 + b_j_fused_1_0 * 32 + b_j_fused_1_1 * 32 + b_j_fused_1_2)
                                T.reads(projection_acc[v_b, v_j])
                                T.writes(Output[v_b, v_j])
                                T.sblock_attr({"gtsim.register_stages": 3})
                                Output[v_b, v_j] = T.Cast("bfloat16", projection_acc[v_b, v_j])